FROM python:3.10-slim

WORKDIR /workspace

# 빌드 및 네트워크 진단 도구
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 머신러닝 및 파이프라인 필수 의존성 설치
RUN pip install --no-cache-dir \
    numpy==1.24.3 \
    scipy==1.11.4 \
    scikit-learn==1.3.2 \
    joblib==1.3.2 \
    redis==5.0.1 \
    pydantic==2.6.1 \
    networkx==2.5.1

# 소스 코드 복사
COPY model /workspace/model
COPY pipeline /workspace/pipeline
COPY harness /workspace/harness
COPY rules /workspace/rules

ENV PYTHONPATH=/workspace
ENV PYTHONUNBUFFERED=1
ENV REDIS_URL=redis://sdn-redis:6379/0

CMD ["python", "-m", "model.inference_worker", "--model", "model/isolation_forest.joblib"]
