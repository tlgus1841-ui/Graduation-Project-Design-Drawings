# Self-Defending SDN Tower: Production Environment Variables
# Copy to .env if custom settings are required.

# SDN Control Plane & API
SDN_MOCK=0
LOG_LEVEL=INFO
REDIS_URL=redis://sdn-redis:6379/0

# Optional: Admin Secret Token for manual control endpoints
# SDN_ADMIN_TOKEN=secret-token-here

# Ports Configuration
HTTP_PORT=80
API_PORT=8000
OPENFLOW_PORT=6653
REDIS_PORT=6379
